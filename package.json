{
  "name": "rika-nodejs",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "My home tasks from the EPAM Node.js Global Mentoring Program (2023), renovated in 2026: a REPL, a process monitor, an EventEmitter, streams, tests, a node:http API, an Express API and SQLite",
  "scripts": {
    "module-1": "bun module-1/repl.ts",
    "module-2": "bun module-2/monitor.ts",
    "module-3:events": "bun module-3/events-demo.ts",
    "module-3:time": "bun module-3/with-time-demo.ts",
    "module-3:csv": "bun module-3/csv-to-json.ts",
    "module-4": "bun module-4/cli.ts",
    "module-5": "bun --watch module-5/server.ts",
    "module-6": "bun --watch module-6/server.ts",
    "module-7": "bun --watch module-7/server.ts",
    "test": "bun test",
    "test:e2e": "E2E=1 bun test module-4",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:ci": "biome ci .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "joi": "^18.3.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/bun": "^1.4.5",
    "@types/express": "^5.0.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.8"
  }
}
