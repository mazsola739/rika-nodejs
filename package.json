{
	"name": "nodejs-global-mentoring-program",
	"version": "1.4.0",
	"description": "NodeJS Global Mentoring Program [2023 Q3-Q4 EU]",
	"main": "index.js",
	"scripts": {
		"random": "nodemon --delay 5 --inspect ./module-1/index.js",
		"start": "nodemon --delay 5 --inspect ./module-2/activityMonitor.js",
		"task1": "nodemon --delay 5 --inspect ./module-3/eventEmitterTest.js",
		"task2": "nodemon --delay 5 --inspect ./module-3/withTimeTest.js",
		"task3": "nodemon --delay 5 --inspect ./module-3/csvToJson.js",
		"test": "jest",
		"test:coverage": "jest --coverage",
		"server": "npx tsc && nodemon --inspect ./dist/module-5/server.js"
	},
	"keywords": [
		"NodeJS"
	],
	"author": "Rika",
	"license": "ISC",
	"nodemonConfig": {
		"delay": 2500,
		"ext": "ts",
		"ignore": [
			"module-5/db/*.json"
		]
	},
	"devDependencies": {
		"@types/jest": "^29.0.0",
		"@types/node": "^18.7.16",
		"@types/supertest": "^2.0.12",
		"jest": "^29.0.3",
		"nodemon": "^3.0.1",
		"supertest": "^6.2.4",
		"ts-jest": "^29.0.0",
		"ts-node": "^10.9.1",
		"typescript": "^4.8.3"
	},
	"dependencies": {
		"axios": "^1.5.0",
		"csvtojson": "^2.0.10"
	}
}
